{
  "name": "react-native-qrcode-skia-example",
  "version": "1.0.0",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "bun setup-skia-web && node path-fs-canvaskit-postinstall.js",
    "copy-canvaskit-in-dist": "cp -r public/canvaskit.wasm dist/_expo/static/js/web/canvaskit.wasm",
    "deploy": "gh-pages -t -d dist",
    "predeploy": "expo export -p web && bun copy-canvaskit-in-dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/state": "^2.1.15",
    "@shopify/react-native-skia": "2.6.2",
    "burnt": "^0.12.2",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "pressto": "^0.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.2",
    "gh-pages": "^6.3.0"
  },
  "private": true
}
